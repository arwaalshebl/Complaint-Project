@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model ComplaintProj.ViewModel.ComplaintViewModel

@{
    ViewData["Title"] = "View Complaint Details";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">

            <h2 class="text-center text-primary mb-5">
                Patient Complaint Details
            </h2>
            <form>
                <!-- Patient Information -->
                <h5 class="text-primary mb-4">Patient Information</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="PatientName" class="form-label fw-bold"></label>
                        <input asp-for="PatientName" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateOfBirth" class="form-label fw-bold"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="text" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Job" class="form-label fw-bold"></label>
                        <input asp-for="Job" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nationality" class="form-label fw-bold"></label>
                        <input asp-for="Nationality" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                </div>
                <hr>

                <!-- Complaint Details -->
                <h5 class="text-primary mb-4">Complaint Details</h5>

                <div class="mb-4">
                    <label asp-for="ComplaintType" class="form-label d-block fw-bold"></label>
                    <div class="form-check form-check-inline">
                        <input asp-for="ComplaintType" class="form-check-input" type="radio" value="Medical" id="typeMedical" disabled>
                        <label class="form-check-label" for="typeMedical">Medical</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input asp-for="ComplaintType" class="form-check-input" type="radio" value="Non-Medical" id="typeNonMedical" disabled>
                        <label class="form-check-label" for="typeNonMedical">Non-Medical</label>
                    </div>
                </div>

@*                 <div class="mb-4">
                    befor checkbox
                    <label asp-for="ComplaintCategory" class="form-label fw-bold"></label>

                    <select asp-for="ComplaintCategory" class="form-select" disabled>
                        <option value="">Select Category</option>
                        <option value="Waiting Time">Waiting Time</option>
                        <option value="Billing and Fees">Billing and Fees</option>
                        <option value="Behavior and Attitude">Behavior and Attitude</option>
                        <option value="Incorrect Diagnosis or Treatment">Incorrect Diagnosis or Treatment</option>
                        <option value="Medication Errors">Medication Errors</option>
                        <option value="Communication">Communication</option>
                        <option value="Other">Other</option>
                    </select>
                </div> *@
                

<div class="mb-4">
    <label class="form-label d-block fw-bold">Complaint Category </label>
    
    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detWaitingTime" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Waiting Time") ? "checked" : "")>
        <label class="form-check-label" for="detWaitingTime">Waiting Time</label>
    </div>
    
    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detBilling" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Billing and Fees") ? "checked" : "")>
        <label class="form-check-label" for="detBilling">Billing and Fees</label>
    </div>

    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detBehavior" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Behavior and Attitude") ? "checked" : "")>
        <label class="form-check-label" for="detBehavior">Behavior and Attitude</label>
    </div>

    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detDiagnosis" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Incorrect Diagnosis or Treatment") ? "checked" : "")>
        <label class="form-check-label" for="detDiagnosis">Incorrect Diagnosis or Treatment</label>
    </div>

    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detMedication" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Medication Errors") ? "checked" : "")>
        <label class="form-check-label" for="detMedication">Medication Errors</label>
    </div>

    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detCommunication" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Communication") ? "checked" : "")>
        <label class="form-check-label" for="detCommunication">Communication</label>
    </div>

    <div class="form-check form-check-inline mb-2">
        <input class="form-check-input" type="checkbox" id="detOther" disabled 
               @(Model.ComplaintCategory != null && Model.ComplaintCategory.Contains("Other") ? "checked" : "")>
        <label class="form-check-label" for="detOther">Other</label>
    </div>
</div>
                <div class="mb-4">
                    <label asp-for="ComplaintLocation" class="form-label fw-bold"></label>

                    <select asp-for="ComplaintLocation" class="form-select" disabled>
                        <option selected disabled value="">Select Location</option>
                        <option value="Dental Clinic">Dental Clinic</option>
                        <option value="Surgery">Surgery</option>
                        <option value="Outpatient Clinics">Outpatient Clinics</option>
                        <option value="Inpatient Department">Inpatient Department</option>
                    </select>

                    <input type="hidden" asp-for="ComplaintLocation" />

                    <span asp-validation-for="ComplaintLocation" class="text-danger small"></span>
                </div>


                <div class="mb-4">
                    <label asp-for="ComplaintSummary" class="form-label fw-bold"></label>
                    <textarea asp-for="ComplaintSummary" class="form-control" rows="5" readonly></textarea>
                </div>
                <!-- attachemnt -->
                @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                {
                    <div class="mb-4">
                        <label class="form-label d-block fw-bold">Attached Documents</label>
                        @foreach (var fileName in Model.AttachmentPath.Split(','))
                        {
                            var displayName = fileName.Length > 37 ? fileName.Substring(37) : fileName;

                            <a href="~/uploads/@fileName" target="_blank" class="btn btn-outline-primary btn-sm me-2 mb-2">
                                📄 View Document (@displayName)
                            </a>
                        }
                    </div>
                }

               

            </form>

            @if (SignInManager.IsSignedIn(User))
            {
                <!--assign-->
                @if (User.IsInRole("Admin") || User.IsInRole("PatientServices"))
                {
                   
                        <div class="card my-3">
                            <div class="card-header bg-dark text-white fw-bold">Assignment Information</div>
                            <div class="card-body">
                                <p><strong>Current Status:</strong> <span class="badge bg-success">@Model.Status</span></p>
                                <p><strong>Assigned Staff Name:</strong> @Model.AssignedStaffName</p>
                            </div>
                        </div>
                    
                    @if (Model.Status == "New" || Model.Status == "Reopened,Unresolved" )
                    {
                        <form asp-controller="Complaints" asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mb-4 p-3 border rounded bg-light">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-3">
                                <label class="form-label fw-bold">Complaint Assignment To (Department):</label>
                                <select name="ComplaintAssignment" class="form-select">
                                    <option selected disabled value="">Select Department</option>
                                    <option value="Dental Clinic">Dental Clinic</option>
                                    <option value="Surgery">Surgery</option>
                                    <option value="Outpatient Clinics">Outpatient Clinics</option>
                                    <option value="Inpatient Department">Inpatient Department</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AssignedStaffId" class="form-label fw-bold">Select Healthcare Staff</label>
                                <select asp-for="AssignedStaffId" asp-items="Model.HealthcareStaffList" class="form-select" required>
                                    <option value="">-- Choose Staff Member from Identity Users --</option>
                                </select>
                                <span asp-validation-for="AssignedStaffId" class="text-danger"></span>
                            </div>


    
                            <button type="submit" class="btn btn-primary px-4">
                                Assign Complaint
                            </button>
                        </form>
                    }



                }
               

                else if (User.IsInRole("HealthcareProvider"))
                {
                    <!--REPLY-->
                    @if (Model.Status == "In Progress,Assigned" || Model.Status == "In Progress,ReAssigned")
                    {
                        <div class="card border-primary mb-4">
                            <div class="card-header bg-primary text-white fw-bold">🩺 Healthcare Staff Action: Write Reply</div>
                            <div class="card-body">
                                <form asp-controller="Complaints" asp-action="Reply" asp-route-id="@Model.Id" method="post" class="mb-4 p-3 border rounded bg-light">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Your Medical/Technical Reply</label>
                                        <textarea name="staffReply" class="form-control" rows="4" placeholder="Type your dynamic update or new reply here..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Send Reply</button>
                                </form>
                            </div>
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(Model.StaffReply))
                {
                    <div class="card border-success mb-4">
                        <div class="card-header bg-success text-white fw-bold">✅ Medical Staff Response Received</div>
                        <div class="card-body">
                            <hr />
                            <p class="mb-2"><strong>Staff Reply History :</strong></p>

                            <div class="replies-history-container" style="max-height: 350px; overflow-y: auto;">
                                @if (Model.AllRepliesList != null && Model.AllRepliesList.Any())
                                {
                                    @foreach (var replyItem in Model.AllRepliesList)
                                    {
                                        <div class="p-3 mb-2 bg-light rounded border shadow-sm">
                                            <p class="mb-0 text-dark" style="white-space: pre-line;">@replyItem</p>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="p-3 bg-light rounded border">
                                        <p class="mb-0" style="white-space: pre-line;">@Model.StaffReply</p>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        @if (User.IsInRole("Admin") || User.IsInRole("PatientServices"))
                        {

                            @if ( Model.Status == "In Progress,Replied")
                            {
                                <div class="card-footer bg-light border-top border-success-subtle p-3 d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle"></i> Review required before patient can view this response.
                                    </small>
                                    <!--approve-->
                                    <form asp-action="Approve" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm hover-elevate">
                                            <i class="bi bi-check-circle-fill me-2"></i> Approve
                                        </button>
                                    </form>

                                    <!--Reassign-->
                                    <button class="btn btn-outline-warning px-4 mb-3 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#reassignSection" aria-expanded="false" aria-controls="reassignSection">
                                        <i class="bi bi-arrow-repeat"></i> ReAssign to Another Staff
                                    </button>

                                    <div class="collapse" id="reassignSection">
                                        <form asp-controller="Complaints" asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mb-4 p-4 border border-danger-subtle rounded-3 bg-light shadow-sm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" asp-for="Id" />

                                            <div class="mb-3">
                                                <label asp-for="AssignedStaffId" class="form-label fw-bold text-dark">Select New Healthcare Staff:</label>
                                                <select asp-for="AssignedStaffId" asp-items="Model.HealthcareStaffList" class="form-select border-danger-subtle" required>
                                                    <option value="">-- Choose Staff Member from Identity Users --</option>
                                                </select>
                                                <span asp-validation-for="AssignedStaffId" class="text-danger"></span>
                                            </div>

                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-warning px-4 fw-bold">
                                                    <i class="bi bi-check-circle me-1"></i> Confirm ReAssignment
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                </div>
                            }
                        }
                    </div>


                }


            }


            <!-- feedback -->
            @if (User.IsInRole("Patient") && Model.Status == "In Progress,Approve")
            {
                if (string.IsNullOrEmpty(Model.IsSatisfied) || Model.IsSatisfied == "Not Satisfied")
                {
                    <div class="card border-warning mb-4 shadow-sm">
                        <div class="card-header bg-warning text-dark fw-bold">📝 Patient Satisfaction Feedback</div>
                        <div class="card-body">
                            <form asp-controller="Complaints" asp-action="SubmitFeedback" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()

                                <div class="mb-4">
                                    <label class="form-label fw-bold d-block fs-5">Are you satisfied with the new resolution of your complaint?</label>

                                    <div class="form-check form-check-inline me-4 mt-2">
                                        <input class="form-check-input" type="radio" name="satisfaction" id="satisfiedRadio" value="Satisfied" required>
                                        <label class="form-check-label text-success fw-bold fs-6" for="satisfiedRadio">
                                            <i class="bi bi-emoji-smile-fill"></i> Satisfied
                                        </label>
                                    </div>

                                    <div class="form-check form-check-inline mt-2">
                                        <input class="form-check-input" type="radio" name="satisfaction" id="notSatisfiedRadio" value="Not Satisfied" required>
                                        <label class="form-check-label text-danger fw-bold fs-6" for="notSatisfiedRadio">
                                            <i class="bi bi-emoji-frown-fill"></i> Not Satisfied
                                        </label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-dark fw-bold px-4 rounded-pill">Submit Feedback</button>
                            </form>
                        </div>
                    </div>
                }
            }


            <!--send feedback -->
            @if (!string.IsNullOrEmpty(Model.IsSatisfied))
            {
                <div class="card border-info mb-4 shadow-sm">
                    <div class="card-header bg-info text-dark fw-bold">📊 Patient Feedback Status</div>
                    <div class="card-body py-3">

                        @if (Model.Status == "In Progress,Approve" && Model.IsSatisfied == "Not Satisfied")
                        {
                            <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                <div>
                                    <strong>Previous Feedback:</strong> You were <u>Not Satisfied</u>.
                                    <span class="badge bg-primary ms-2 animate-pulse">New Staff Reply Added</span>
                                    <br><small class="text-muted">Please review the medical staff response below and submit your updated feedback.</small>
                                </div>
                            </div>
                        }
                        else if (Model.IsSatisfied == "Satisfied")
                        {
                            <span class="fw-bold me-2">Current Status:</span>
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill"></i> Case Closed & Satisfied
                            </span>
                        }
                        else if (Model.Status == "Reopened,Unresolved" && Model.IsSatisfied == "Not Satisfied")
                        {
                            <span class="fw-bold me-2">Current Status:</span>
                            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill">
                                <i class="bi bi-exclamation-octagon-fill"></i> Reopened 
                            </span>
                        }

                    </div>
                </div>
            }


            <a asp-controller="Complaints" asp-action="Report" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-bold px-3">
                📄 Generate Official Report
            </a>

            <a asp-action="Index" class="btn btn-secondary px-4">
                Back to List
            </a>
        </div>
    </div>
</div>


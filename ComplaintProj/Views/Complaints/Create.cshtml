@model ComplaintProj.ViewModel.ComplaintViewModel

@{
    ViewData["Title"] = "Submit Complaint";
}
@* <!--lang-->
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ComplaintProj.SharedResource> SharedLocalizer
<!--lang--> *@

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">
          @*   <!--lang-->
          <h2 class="text-center text-primary mb-5">@SharedLocalizer["FormTitle"]</h2> *@
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active">Patient Complaint Submission Form</li>
                </ol>
            </nav>
            <h2 class="text-center text-primary mb-5">
                Patient Complaint Submission Form
            </h2>
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <!-- Patient Information -->
                <h5 class="text-primary mb-4">Patient Information</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                      @*   <!--lang-->
                        <label asp-for="PatientName" class="form-label">@SharedLocalizer["PatientName"]</label> *@

                        <label asp-for="PatientName" class="form-label fw-bold"></label>
                        <input asp-for="PatientName" class="form-control" placeholder="Enter full name">
                        <span asp-validation-for="PatientName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="e.g., 05xxxxxxx">
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateOfBirth" class="form-label fw-bold"></label>
                        <input asp-for="DateOfBirth" class="form-control">
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Job" class="form-label fw-bold"></label>
                        <input asp-for="Job" class="form-control" placeholder="Current occupation">
                        <span asp-validation-for="Job" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nationality" class="form-label fw-bold"></label>
                        <input asp-for="Nationality" class="form-control" placeholder="e.g., Saudi">
                        <span asp-validation-for="Nationality" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="example@mail.com">
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <hr>

                <!-- Complaint Details -->
                <h5 class="text-primary mb-4">Complaint Details</h5>

                
                <div class="mb-4">
                    <label asp-for="ComplaintType" class="form-label d-block fw-bold"></label>
                    <div class="form-check form-check-inline">
                        <input asp-for="ComplaintType" class="form-check-input" type="radio" value="Medical" id="typeMedical">
                        <label class="form-check-label" for="typeMedical">Medical</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input asp-for="ComplaintType" class="form-check-input" type="radio" value="Non-Medical" id="typeNonMedical">
                        <label class="form-check-label" for="typeNonMedical">Non-Medical</label>
                    </div>
                    <span asp-validation-for="ComplaintType" class="text-danger d-block small"></span>
                </div>
@* 
                befor checkbox
                <div class="mb-4">
                    <label asp-for="ComplaintCategory" class="form-label fw-bold"></label>
                    <select asp-for="ComplaintCategory" class="form-select">
                        <option selected disabled value="">Select Category</option>
                        <option value="Waiting Time">Waiting Time</option>
                        <option value="Billing and Fees">Billing and Fees</option>
                        <option value="Behavior and Attitude">Behavior and Attitude</option>
                        <option value="Incorrect Diagnosis or Treatment">Incorrect Diagnosis or Treatmentoption</option>
                            <option value="Medication Errors">Medication Errors</option>
                            <option value="Communication">Communication</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="ComplaintCategory" class="text-danger small"></span>
                </div> *@
                <div class="mb-4">
                    <label class="form-label d-block fw-bold">Complaint Category</label>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Waiting Time" id="catWaitingTime">
                        <label class="form-check-label" for="catWaitingTime">Waiting Time</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Billing and Fees" id="catBilling">
                        <label class="form-check-label" for="catBilling">Billing and Fees</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Behavior and Attitude" id="catBehavior">
                        <label class="form-check-label" for="catBehavior">Behavior and Attitude</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Incorrect Diagnosis or Treatment" id="catDiagnosis">
                        <label class="form-check-label" for="catDiagnosis">Incorrect Diagnosis or Treatment</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Medication Errors" id="catMedication">
                        <label class="form-check-label" for="catMedication">Medication Errors</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Communication" id="catCommunication">
                        <label class="form-check-label" for="catCommunication">Communication</label>
                    </div>

                    <div class="form-check form-check-inline mb-2">
                        <input class="form-check-input" type="checkbox" name="ComplaintCategory" value="Other" id="catOther">
                        <label class="form-check-label" for="catOther">Other</label>
                    </div>

                    <span asp-validation-for="ComplaintCategory" class="text-danger d-block small"></span>
                </div>

                <!-- قائمة المواقع مجهزة بـ asp-for -->
                <div class="mb-4">
                    <label asp-for="ComplaintLocation" class="form-label fw-bold"></label>
                    <select asp-for="ComplaintLocation" class="form-select">
                        <option selected disabled value="">Select Location</option>
                            <option value="Dental Clinic">Dental Clinic</option>
                            <option value="Surgery">Surgery</option>
                            <option value="Outpatient Clinics">Outpatient Clinics</option>
                            <option value="Inpatient Department">Inpatient Department</option>
                    </select>
                    <span asp-validation-for="ComplaintLocation" class="text-danger small"></span>
                </div>

                <!-- حقل الملخص مجهز بـ asp-for -->
                <div class="mb-4">
                    <label asp-for="ComplaintSummary" class="form-label fw-bold"></label>
                    <textarea asp-for="ComplaintSummary" class="form-control" rows="5" placeholder="Describe your complaint here..."></textarea>
                    <span asp-validation-for="ComplaintSummary" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Attachments" class="form-label fw-bold">Supporting Documents (Photos or Reports)</label>
                    <!-- قمنا بتحديد الامتدادات المسموحة مثل الصور وملفات الـ PDF والـ Word -->
                    <input asp-for="Attachments" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.docx,.doc" multiple />

                    <span asp-validation-for="Attachments" class="text-danger small"></span>
                    <div class="form-text small text-muted">Allowed formats: Photos (JPG, PNG) or Reports (PDF, Word).</div>
                </div>


                <button type="submit" class="btn btn-primary px-4">
                    Submit Complaint
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <!-- تفعيل ميزة التحقق الفوري في المتصفح -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

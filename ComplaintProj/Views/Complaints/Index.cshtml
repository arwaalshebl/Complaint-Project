@model List<ComplaintProj.Models.ComplaintModel>

<div class="container py-5">


    <!-- Header Section -->
    <div class="row bg-light p-4 rounded-4 shadow-sm mb-4 align-items-center border-0">
        <div class="col-md-8">

            <h1 class="display-6 fw-bold text-dark">Review patient complaints</h1>
        </div>

        <div class="col-md-4 text-end">

            <div class="bg-white p-3 rounded-4 shadow-sm border-start border-primary border-4 d-inline-block text-start">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Total Complaints</small>

                <h3 class="mb-0 fw-bold text-primary">@(Model.Count())</h3>

            </div>

        </div>

    </div>

    <!-- Table Section -->
    <div class="bg-white p-4 rounded-4 shadow-sm border">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 rounded-start-3 py-3" style="width: 100px;">ID</th>
                        <th class="border-0 py-3"> Patient Name</th>
                        <th class="border-0 py-3">Complaint Date</th>
                        <th class="border-0 py-3">Clinic</th>
                        <th class="border-0 py-3">Type of Complaint</th>
                        <th class="border-0 py-3">Reason</th>
                        <th class="border-0 py-3">Status</th> <!--colorfull-->
                        <th>Assigned To</th>
                        <th class="border-0 py-3">Details</th>
                    
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <td class="text-muted fw-bold">#@item.Id</td>
                            <td>
                                <!--role : admin & s -->

                                <div class="d-flex align-items-center">
                                   
                                    <span class="fw-bold text-dark">@item.PatientName</span>
                                </div>
                            </td>

                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.CreatedAt</span>
                                </div>
                            </td>

                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintLocation</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintType</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintCategory</span>
                                </div>
                            </td>
                            <td>
          
                                <div class="d-flex align-items-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm dropdown-toggle rounded-pill px-3 @(item.Status == "New" ? "btn-danger-subtle text-danger" : "btn-success-subtle text-success")"
                                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            @(item.Status ?? "New")
                                        </button>

                                        <ul class="dropdown-menu shadow border-0 rounded-3">
                                            <li>
                                                <a class="dropdown-item" asp-action="UpdateStatus" asp-route-id="@item.Id" asp-route-status="New">
                                                    <span class="badge bg-warning-subtle text-warning rounded-pill">New</span>
                                                </a>
                                            </li>
                                            <li>
                                                <!--when assigned will change-->
                                                <a class="dropdown-item" asp-action="UpdateStatus" asp-route-id="@item.Id" asp-route-status="In Progress">
                                                    <span class="badge bg-danger-subtle text-danger rounded-pill">In Progress</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="UpdateStatus" asp-route-id="@item.Id" asp-route-status="Closed">
                                                    <span class="badge bg-success-subtle text-success rounded-pill">Closed</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>

                                </div>

         
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.AssignedStaffId))
                                {
                                
                                    <span class="badge bg-info text-dark">👤 Assigned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Assigned Yet</span>
                                }
                            </td>
                           <td>
       
                                <div class="d-flex align-items-center">

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-4">
                                        Details
                                    </a>
                                </div>

                            </td>

                        </tr>
                    }
                </tbody>
                <div class="d-flex align-items-center">

                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                        Create new complaint
                    </a>
                </div>
            </table>
        </div>


    </div>
</div>
@model IEnumerable<ComplaintProj.ViewModel.ComplaintViewModel>


<div class="container py-5">


    <!-- Header Section -->
    <div class="row bg-light p-4 rounded-4 shadow-sm mb-4 align-items-center border-0">
        <div class="col-md-8">

            <h1 class="display-6 fw-bold text-dark">Review patient complaints</h1>
        </div>

        <div class="col-md-4 text-end">

            <div class="bg-white p-3 rounded-4 shadow-sm border-start border-primary border-4 d-inline-block text-start">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Total Complaints</small>

                <h3 class="mb-0 fw-bold text-primary">@(Model.Count())</h3>

            </div>

        </div>

    </div>

    <!-- Table Section -->
    <div class="bg-white p-4 rounded-4 shadow-sm border">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 rounded-start-3 py-3" style="width: 100px;">ID</th>
                        @if (!User.IsInRole("Patient"))
                        {
                            <th class="border-0 py-3">Patient Name</th>
                        }
                        <th class="border-0 py-3">Complaint Date</th>
                        <th class="border-0 py-3">Clinic</th>
                        <th class="border-0 py-3">Type of Complaint</th>
                        <th class="border-0 py-3">Reason</th>
                        <th class="border-0 py-3">Status</th> <!--colorfull-->
                        <th>Assigned To</th>
                        <th class="border-0 py-3">Details</th>
                        <th class="border-0 py-3">Delete</th>

                    
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <td class="text-muted fw-bold">#@item.Id</td>
                           
                                @if (!User.IsInRole("Patient"))
                                {
                                    <td class="align-middle fw-semibold text-dark">@item.PatientName</td>
                                }
                            

                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.CreatedAt</span>
                                </div>
                            </td>

                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintLocation</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintType</span>
                                </div>
                            </td>
                            <td>
                        @*         <div class="d-flex align-items-center">

                                    <span class="fw-bold text-dark">@item.ComplaintCategory</span>
                                </div> *@
                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    @if (item.ComplaintCategory != null && item.ComplaintCategory.Any())
                                    {
                                        foreach (var category in item.ComplaintCategory)
                                        {
                                            <span class="fw-bold text-dark">
                                                @category
                                            </span>
                                        }

                                     
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Category Selected</span>
                                    }
                                </div>
                            </td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center align-items-center">
                                    @if (item.IsSatisfied == "Not Satisfied" )
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill fw-bold small">
                                            <i class="bi bi-exclamation-triangle-fill me-1">Reopened,Unresolved</i>
                                        </span>
                                    }
                                     @if (item.Status == "New" || string.IsNullOrEmpty(item.Status))
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill fw-bold small">
                                            <i class="bi bi-star-fill me-1"></i> New
                                        </span>
                                    }
                                    else if (item.Status == "In Progress,Assigned")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill fw-bold small">
                                            <i class="bi bi-person-gear me-1"></i> In Progress (Assigned)
                                        </span>
                                    }
                                    else if (item.Status == "In Progress,Replied")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-3 py-2 rounded-pill fw-bold small">
                                            <i class="bi bi-chat-left-text-fill me-1"></i> In Progress (Replied)
                                        </span>
                                    }
                                    else if (item.Status == "Closed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-bold small">
                                            <i class="bi bi-check-circle-fill"></i> Closed
                                        </span>
                                    }
                                    else
                                    {
                                        
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 rounded-pill fw-bold small">
                                            @item.Status
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.AssignedStaffId))
                                {
                                
                                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill fw-bold small">👤 Assigned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 rounded-pill fw-bold small">Not Assigned Yet</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @if (User.IsInRole("HealthcareProvider"))
                                {
                                    @if (item.Status == "In Progress,Assigned" )
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                            <i class="bi bi-chat-left-dots-fill me-1"></i> Reply Now
                                        </a>
                                    }
                                    else
                                    {
                                      
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                            <i class="bi bi-eye-fill me-1"></i> View Details
                                        </a>
                                    }
                                }
                                else
                                {
                                  
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        View 
                                    </a>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this complaint?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-trash3 me-1"></i> Delete
                                    </button>
                                </form>
                            </td>

                        </tr>
                    }
                </tbody>
                <div class="d-flex align-items-center">

                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                        Submit New Complaint
                    </a>
                </div>
            </table>
        </div>


    </div>
</div>
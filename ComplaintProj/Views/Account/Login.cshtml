
@model ComplaintProj.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid vh-100">
    <div class="row vh-100">


        <!-- Right Side: Login Form -->
        <div class="col-md-6 d-flex align-items-center justify-content-center bg-light">
            <div class="col-10 col-sm-8 col-lg-7">



                <div class="mb-4">
                    <h3 class="fw-bold">Login</h3>
                    <p class="text-muted">Welcome back! Please enter your details.</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Email Field -->
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control border-0 shadow-sm" id="floatingInput" placeholder="name@example.com" style="border-radius: 12px;">
                        <label asp-for="Email" for="floatingInput" class="text-muted">Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control border-0 shadow-sm" id="floatingPassword" placeholder="Password" style="border-radius: 12px;">
                        <label asp-for="Password" for="floatingPassword" class="text-muted">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Options -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                            <label class="form-check-label small text-secondary" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="small text-decoration-none fw-bold">Forgot password?</a>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="btn btn-primary w-100 py-3 shadow" style="border-radius: 12px; background-color: #00419e; border: none;">
                        Sign In
                    </button>
                </form>

                <div class="text-center mt-5">
                    <p class="text-muted">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Join for free</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

